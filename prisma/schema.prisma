generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum PostType {
  BLOG
  RESOURCE
  PAGE
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  DONE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  role          Role      @default(EDITOR)
  image         String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SiteSettings {
  id                    String   @id @default(cuid())
  siteName              String   @default("Sinhala Hadahana")
  tagline               String   @default("Trusted Horoscope Guidance")
  logoUrl               String?
  faviconUrl            String?
  heroImageUrl          String?
  primaryColor          String   @default("#1E3A8A")
  secondaryColor        String   @default("#0EA5E9")
  backgroundColor       String   @default("#F8FAFC")
  textColor             String   @default("#0F172A")
  fontFamily            String   @default("Noto Sans Sinhala")
  containerWidth        String   @default("max-w-7xl")
  headerStyle           String   @default("glass")
  buttonStyle           String   @default("rounded")
  footerText            String   @default("Informational purposes only")
  navItemsJson          String   @default("[]")
  socialLinksJson       String   @default("{}")
  mapEmbedUrl           String?
  defaultMetaTitle      String   @default("Sinhala Hadahana")
  defaultMetaDescription String  @default("AI-powered Sinhala horoscope reviews")
  ogImageUrl            String?
  canonicalUrl          String?
  robotsAllowIndex      Boolean  @default(true)
  disclaimerTextSi      String   @default("මෙම හදහන තොරතුරු සහ විනෝදාස්වාද අරමුණු සඳහා පමණි.")
  disclaimerTextEn      String   @default("For informational and entertainment purposes only.")
  horoscopeTemplatesJson String  @default("{}")
  tonePreset            String   @default("Professional")
  snippetLibraryJson    String   @default("{}")
  updatedAt             DateTime @updatedAt
}

model Post {
  id              String    @id @default(cuid())
  title           String
  slug            String    @unique
  excerpt         String?
  content         String
  language        String    @default("en")
  type            PostType  @default(BLOG)
  published       Boolean   @default(false)
  scheduledAt     DateTime?
  featuredImage   String?
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  featured        Boolean   @default(false)
  categories      Category[]
  tags            Tag[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Category {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique
  posts Post[]
}

model MediaAsset {
  id         String   @id @default(cuid())
  url        String
  alt        String?
  type       String
  createdAt  DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  message   String
  status    ContactStatus @default(NEW)
  notes     String?
  createdAt DateTime      @default(now())
}

model HoroscopeRequest {
  id          String   @id @default(cuid())
  fullName    String
  gender      String
  dob         DateTime
  tob         String
  place       String
  latitude    Float
  longitude   Float
  timezone    String
  language    String
  createdAt   DateTime @default(now())
  result      HoroscopeResult?
}

model HoroscopeResult {
  id                  String   @id @default(cuid())
  requestId           String   @unique
  lagna               String
  rashi               String
  highlightsJson      String
  planetaryTableJson  String
  predictionsJson     String
  timelineJson        String
  actionPlanJson      String
  pdfUrl              String?
  docxUrl             String?
  createdAt           DateTime @default(now())
  request             HoroscopeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}
